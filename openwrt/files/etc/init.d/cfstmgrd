#!/bin/sh /etc/rc.common
# =============================================================================
# cfstmgrd — OpenWrt procd 服务脚本
#
#   由 ipk 包安装到 /etc/init.d/cfstmgrd，受 procd 守护。
#   配置读自 UCI: /etc/config/cfstmgrd (main 节)，转成 CFST_* 环境变量注入。
#   守护进程本身只认环境变量（见 internal/appcfg），故二进制零改动。
#
#   子命令 start/stop/restart/reload/enable/disable/status 由 /etc/rc.common 提供：
#     /etc/init.d/cfstmgrd start      启动
#     /etc/init.d/cfstmgrd enable     开机自启
#   修改配置后:  uci commit cfstmgrd; /etc/init.d/cfstmgrd restart
# =============================================================================

USE_PROCD=1
# 网络起来后再启动；停止时尽早
START=95
STOP=01

PROG=/usr/bin/cfstmgrd
CONF=cfstmgrd

# ---------------------------------------------------------------------------
# 生成强随机 16 进制令牌 (48 字符)。取不到随机源时返回空串 (由 ensure_token 拒绝启动)。
# 按可用性逐级回退：① od ② hexdump ③ sha256sum ④ md5sum ⑤ 内核 uuid ⑥ /dev/urandom 筛字符
# ---------------------------------------------------------------------------
gen_token() {
	local t=''
	if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
		t="$(dd if=/dev/urandom bs=1 count=24 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
	fi
	if [ "${#t}" -lt 32 ] && [ -r /dev/urandom ] && command -v hexdump >/dev/null 2>&1; then
		t="$(dd if=/dev/urandom bs=1 count=24 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)"
	fi
	if [ "${#t}" -lt 32 ] && [ -r /dev/urandom ] && command -v sha256sum >/dev/null 2>&1; then
		t="$(dd if=/dev/urandom bs=1 count=64 2>/dev/null | sha256sum 2>/dev/null | cut -c1-48)"
	fi
	if [ "${#t}" -lt 32 ] && [ -r /dev/urandom ] && command -v md5sum >/dev/null 2>&1; then
		t="$(dd if=/dev/urandom bs=1 count=64 2>/dev/null | md5sum 2>/dev/null | cut -c1-32)$(dd if=/dev/urandom bs=1 count=64 2>/dev/null | md5sum 2>/dev/null | cut -c1-16)"
	fi
	if [ "${#t}" -lt 32 ] && [ -r /proc/sys/kernel/random/uuid ]; then
		t="$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')"
		t="$(printf '%s' "$t" | cut -c1-48)"
	fi
	if [ "${#t}" -lt 32 ] && [ -r /dev/urandom ]; then
		t="$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 48 2>/dev/null)"
	fi
	printf '%s' "$t"
}

# ---------------------------------------------------------------------------
# 确保存在登录令牌。守护进程要求 CFST_API_TOKEN 非空，否则启动即退出，
# 因此首次启动 (UCI token 为空) 时自动生成一个并落盘。幂等。
# 安全优先：拿不到足够随机度时宁可拒绝启动，绝不退化成可预测弱令牌。
# ---------------------------------------------------------------------------
ensure_token() {
	local t
	config_load "$CONF"
	config_get t main token ''
	[ -n "$t" ] && return 0

	t="$(gen_token)"
	if [ "${#t}" -lt 32 ]; then
		logger -t cfstmgrd "ERROR: 无法生成安全随机令牌 (系统缺少 od/hexdump/sha256sum/md5sum 等工具，且无 /dev/urandom 与内核 uuid 随机源)，拒绝以弱令牌启动。请手动设置: uci set cfstmgrd.main.token=<你的令牌>; uci commit cfstmgrd; /etc/init.d/cfstmgrd restart"
		return 1
	fi
	uci -q set "${CONF}.main.token=$t"
	uci -q commit "$CONF"
	logger -t cfstmgrd "首次启动：已生成随机 API 令牌 (uci get cfstmgrd.main.token 查看)"
}

start_service() {
	local enabled http_addr token data_dir log_level docs_enabled cors_origins public_open

	config_load "$CONF"
	config_get_bool enabled main enabled 1
	if [ "$enabled" != "1" ]; then
		# enabled 是「持久运行状态」：网页点停止会置 0。重启/升级后只要它是 0 就保持停止。
		logger -t cfstmgrd "当前为停止状态 (option enabled '0')，不启动；如需运行请在网页点「启动」或勾选「开机自动启动」"
		return 0
	fi

	# 先确保有令牌 (失败则拒绝启动)，再重新读取拿到最新值
	ensure_token || return 1

	config_load "$CONF"
	config_get      http_addr    main http_addr    ':18123'
	config_get      token        main token        ''
	config_get      data_dir     main data_dir     '/usr/lib/cfstmgrd'
	config_get      log_level    main log_level    'info'
	config_get_bool docs_enabled main docs_enabled 1
	config_get      cors_origins main cors_origins '*'
	# 对外优选 IP API 公开模式：1=接受任意 key（便于第三方/旧客户端无缝接入）
	config_get_bool public_open  main public_open  0

	# 令牌兜底校验：为空则拒绝启动 (否则守护进程读不到 token 会自行退出)
	[ -n "$token" ] || { logger -t cfstmgrd "ERROR: API 令牌为空，拒绝启动"; return 1; }

	[ "$docs_enabled" = "1" ] && docs_enabled="true" || docs_enabled="false"
	[ "$public_open" = "1" ]  && public_open="true"  || public_open="false"

	# 数据目录需持久 (OpenWrt 上 /var -> /tmp 是 tmpfs，重启即丢，切勿用)；
	# 不可写时仅告警不阻断，提示改到可写持久路径 (或先配 extroot)
	mkdir -p "$data_dir" 2>/dev/null
	if touch "$data_dir/.wtest" 2>/dev/null; then
		rm -f "$data_dir/.wtest" 2>/dev/null
	else
		logger -t cfstmgrd "WARNING: 数据目录不可写: $data_dir，请 uci set cfstmgrd.main.data_dir=<可写持久路径> 后重启"
	fi

	# 二进制由 all 包安装时经 cfstmgrd-fetch 联网拉取；若缺失（如装时无网）则拒绝启动并提示
	[ -x "$PROG" ] || {
		logger -t cfstmgrd "ERROR: 二进制未安装 ($PROG)，请联网后执行: cfstmgrd-fetch  然后 /etc/init.d/cfstmgrd start"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param env \
		CFST_API_TOKEN="$token" \
		CFST_HTTP_ADDR="$http_addr" \
		CFST_DATA_DIR="$data_dir" \
		CFST_LOG_LEVEL="$log_level" \
		CFST_DOCS_ENABLED="$docs_enabled" \
		CFST_CORS_ORIGINS="$cors_origins" \
		CFST_PUBLIC_OPEN="$public_open"
	# 崩溃自动拉起：3600s 内异常退出算崩溃，重试 5 次；之后退出则无限重启
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	# 把 stdout/stderr 接入 logd，可用 logread 查看
	procd_set_param stdout 1
	procd_set_param stderr 1
	# 配置文件变更触发实例重载
	procd_set_param file /etc/config/cfstmgrd
	procd_close_instance
}

service_triggers() {
	# 监听 config.change 事件，配置变更后自动 reload
	procd_add_reload_trigger "cfstmgrd"
}
